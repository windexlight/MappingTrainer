   <property name="styleSheet">
    <string notr="true">
        QMenuBar {
            background-color: #f4f4f4;
            spacing: 6px;
            padding: 2px;
            color: black; /* normal text color */
        }
        QMenuBar::item {
            spacing: 4px;
            padding: 5px 12px;
            background: transparent;
            font-weight: 500;
            color: black; /* force text visible */
        }
        QMenuBar::item:hover {
            background-color: #ddd;
            border-radius: 4px;
            color: black; /* ensure text visible */
        }
        QMenuBar::item:pressed {
            background-color: #ccc;
            border-radius: 4px;
            color: black;
        }
        QMenu {
            background-color: #f9f9f9;
            border: 1px solid #ccc;
            padding: 6px;
            color: black; /* menu item text color */
        }
        QMenu::item:selected {
            background-color: #ddd;
            border-radius: 4px;
            color: black;
        }
    </string>
   </property>
